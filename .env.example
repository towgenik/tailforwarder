# .env.example
# This is an example environment file for the Tailscale Forwarder Docker Compose setup.
# Copy this file to .env and fill in your actual values.
# DO NOT commit your actual .env file if it contains sensitive information like TS_AUTHKEY.

# --- Tailscale Authentication ---
# TS_AUTHKEY is only used when a node has to log in: on first start, or when its
# node key has expired / the device was removed. On normal restarts the node
# reconnects using the identity stored in its state volume, so an expired auth
# key does NOT stop an already registered container from starting.
#
# Recommended: an OAuth client secret. It never expires, so the container can
# always re-authenticate unattended.
#   Admin Console -> Settings -> Trust credentials (OAuth clients) -> create a
#   client with the "auth_keys" write scope and a tag (e.g. tag:tailforwarder).
#   Then set TS_TAGS=tag:tailforwarder on every service in docker-compose.yml.
#   Nodes are registered non-ephemeral automatically. If device approval is
#   enabled, append ?preauthorized=true to the secret.
#   Tagged nodes also have node key expiry disabled by default.
# TS_AUTHKEY=tskey-client-XXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
# Alternative: a regular auth key (expires after at most 90 days). Make it
# reusable if several instances share it, and do not make it ephemeral.
# If you use a regular key, disable key expiry for the forwarder devices in the
# admin console, otherwise they need a new key when their node key expires.
TS_AUTHKEY=tskey-auth-YOUR_AUTH_KEY_HERE_REPLACE_ME
